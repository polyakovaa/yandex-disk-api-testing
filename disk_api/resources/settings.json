{
  "startUrl": "https://disk.yandex.ru/",
  "browserName": "firefox",
  "isRemote": false,
  "remoteConnectionUtl": "http://localhost:4444/wd/hub",
  "isElementHighlightEnabled": true,
  "driverSettings": {
    "chrome": {
      "useWebdriver_manager": true,
      "webDriverVersion": "Latest",
      "capabilities": {},
      "options": {
        "intl.accept_languages": "en",
        "safebrowsing.enabled": "true",
        "profile.default_content_settings.popups": "0",
        "disable-popup-blocking": "true",
        "download.default_directory": ".\\downloads",
        "credentials_enable_service": false,
        "profile": {
          "password_manager_enabled": false
        }
      },
      "loggingPreferences": {
        "Performance": "All"
      },
      "excludedArguments": ["enable-automation"],
      "startArguments": ["--incognito"],
      "pageLoadStrategy": "normal"
    },
    "firefox": {
      "webDriverVersion": "Latest",
      "capabilities": {},
      "options": {
        "intl.accept_languages": "en"
      },
      "loggingPreferences": {},
      "excludedArguments": [],
      "startArguments": ["-private"],
      "pageLoadStrategy": "normal"
    }
  },
  "timeouts": {
    "timeoutImplicit": 0,
    "timeoutCondition": 15,
    "timeoutPollingInterval": 0.3,
    "timeoutCommand": 60,
    "timeoutScript": 15,
    "timeoutPageLoad": 15
  },
  "retry": {
    "number": 2,
    "pollingInterval": 0.3
  },
  "logger": {
    "language": "en",
    "logPageSource": false
  },
  "elementCache": {
    "isEnabled": false
  }
}
